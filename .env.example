# Local values: run `npx supabase status -o env`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key

# Admin panel password (min 12 chars) and cookie signing secret (random, 32+ chars)
ADMIN_PASSWORD=change-me-please
ADMIN_SESSION_SECRET=generate-with-openssl-rand-base64-32

# Base URL printed into QR codes
PUBLIC_BASE_URL=http://localhost:3000

# Optional: LAN IPs allowed to use the dev server (phone testing), comma separated
DEV_ALLOWED_ORIGINS=
